# Gmail address that receives contact-form messages (also the sender)
EMAIL_ADDRESS=
# Gmail app password for EMAIL_ADDRESS
GMAIL_PASSKEY=
# Optional: Telegram bot token for best-effort notifications
TELEGRAM_BOT_TOKEN=
# Optional: Telegram chat ID to notify (needs both Telegram vars)
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile secret key: turns on the contact form's bot check
TURNSTILE_SECRET_KEY=
# Optional: override the Turnstile site key built into the contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: hostnames accepted for Turnstile tokens (default: phamtienthuanphat.com,www.phamtienthuanphat.com)
TURNSTILE_ALLOWED_HOSTNAMES=
